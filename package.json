{
  "name": "sqlpulse",
  "version": "1.0.0",
  "private": true,
  "description": "SQLPulse — Multi-Engine Database Performance Visualizer, Migration Linter & Engineering Studios with 10 Core Analyzers and 447-Engine Catalog Matrix",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:core": "npm --prefix backend run build:core",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:core && npm run build:backend && npm run build:frontend",
    "start": "node backend/dist/server.js",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "database",
    "performance",
    "explain-plan",
    "postgresql",
    "mysql",
    "sqlite",
    "mongodb",
    "react",
    "express",
    "finops",
    "migration-linter"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.21.5",
    "@esbuild/darwin-x64": "^0.21.5",
    "@esbuild/linux-arm64": "^0.21.5",
    "@esbuild/linux-x64": "^0.21.5",
    "@rollup/rollup-linux-arm64-gnu": "^4.22.4",
    "@rollup/rollup-linux-arm64-musl": "^4.22.4",
    "@rollup/rollup-linux-x64-gnu": "^4.22.4",
    "@rollup/rollup-linux-x64-musl": "^4.22.4"
  },
  "author": "",
  "license": "MIT"
}
