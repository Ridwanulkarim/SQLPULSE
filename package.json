{
  "name": "sqlpulse",
  "version": "1.0.0",
  "private": true,
  "description": "SQLPulse — Multi-Engine Database Performance Visualizer, Migration Linter & Engineering Studios across 447 Database Systems",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/server.js",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "database",
    "performance",
    "explain-plan",
    "postgresql",
    "mysql",
    "sqlite",
    "mongodb",
    "react",
    "express",
    "finops",
    "migration-linter"
  ],
  "author": "",
  "license": "MIT"
}
