# ==============================================================================
# SQLPulse Environment Configuration
# ==============================================================================

# Server Port (default: 4000)
PORT=4000

# Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Database Connection (Optional)
# If provided, reports are stored in PostgreSQL table `analysis_reports`.
# If omitted, SQLPulse safely uses a bounded in-memory store (max 500 reports with LRU eviction).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sqlpulse

# Security & CORS
# Comma-separated list of allowed origins or single URL
CORS_ORIGIN=http://localhost:5173

# Database SSL Configuration
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt
# DB_SSL_REJECT_UNAUTHORIZED=true
# FORCE_DB_SSL=false
