# ==============================================================================
# SQLPulse Environment Configuration
# ==============================================================================

# Server Port (default: 4000)
PORT=4000

# Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Administrative API Key (Required for listing saved reports via GET /api/v1/reports)
# If left unset, public report listing is disabled for user privacy.
ADMIN_API_KEY=sqlpulse_admin_secret_key_change_me_in_production

# Optional: Report Access Key (Protects individual report permalinks via x-report-key header)
# REPORT_ACCESS_KEY=optional_report_viewer_secret

# Security & CORS (Production: exact deployed frontend domain)
# Comma-separated list of allowed origins or single URL (ALLOWED_ORIGINS or CORS_ORIGIN)
ALLOWED_ORIGINS=https://sqlpulse.vercel.app
CORS_ORIGIN=https://sqlpulse.vercel.app,http://localhost:5173

# Database Connection (Optional)
# If provided, reports are persisted in PostgreSQL table `analysis_reports`.
# If omitted, SQLPulse safely uses a bounded in-memory store (max 500 reports with LRU eviction).
# DATABASE_URL=postgresql://user:password@host:5432/sqlpulse?sslmode=require

# Database SSL Configuration
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt
# DB_SSL_REJECT_UNAUTHORIZED=true
# FORCE_DB_SSL=false
